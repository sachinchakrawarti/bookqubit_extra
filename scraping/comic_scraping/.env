# Database Configuration
DB_PATH=./data/comic.db

# Scraping Configuration
SCRAPE_INTERVAL=3600000
MAX_RETRIES=3
REQUEST_TIMEOUT=10000
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# URLs
# Change this:
COMIC_BOOK_RESOURCES_URL=https://www.comicbookresources.com

# Try these alternative URLs instead:
# Option A: Use the main site
COMIC_BOOK_RESOURCES_URL=https://www.comicbookresources.com

# Option B: Use their news section
COMIC_BOOK_RESOURCES_URL=https://www.cbr.com

# Option C: Use a different comic site
# COMIC_BOOK_RESOURCES_URL=https://www.ign.com/comics